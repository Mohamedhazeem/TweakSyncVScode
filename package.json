{
  "name": "tweaksync",
  "displayName": "TweakSync",
  "description": "TweakSync syncs web page styles between Chrome and VS Code",
  "icon": "resources/icon128.png",
  "publisher": "TweakSync",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mohamedhazeem/TweakSyncVScode.git"
  },
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWorkspaceOpen"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tweakSync.startserver",
        "title": "Start TweakSync",
        "category": "TweakSync"
      },
      {
        "command": "tweakSync.showPanel",
        "title": "Open TweakSync Hub",
        "category": "TweakSync"
      }
    ],
    "icons": {
      "tweakSync-icon": {
        "description": "TweakSync icon",
        "default": {
          "fontPath": "resources/tweakSyncIcon.woff",
          "fontCharacter": "\\e800"
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "build:webview": "webpack --config webpack.config.js",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/postcss-safe-parser": "^5.0.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.89.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.3.9",
    "bufferutil": "^4.0.8",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^8.57.0",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss-loader": "^8.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "utf-8-validate": "^6.0.4",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@shadcn/ui": "^0.0.4",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "css-loader": "^7.1.2",
    "lucide-react": "^0.427.0",
    "node-html-parser": "^6.1.13",
    "postcss": "^8.4.41",
    "postcss-safe-parser": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "source-map": "^0.7.4",
    "style-loader": "^4.0.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.9",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.17.0"
  }
}
