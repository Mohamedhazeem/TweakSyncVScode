{
  "name": "tweaksync",
  "displayName": "TweakSync",
  "description": "TweakSync syncs web page styles between Chrome and VS Code",
  "icon": "resources/icon128.png",
  "publisher": "TweakSync",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mohamedhazeem/TweakSyncVScode.git"
  },
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWorkspaceOpen"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tweakSync.startserver",
        "title": "Start TweakSync",
        "category": "TweakSync"
      },
      {
        "command": "tweakSync.showPanel",
        "title": "Open TweakSync Hub",
        "category": "TweakSync"
      }
    ],
    "icons": {
      "tweakSync-icon": {
        "description": "TweakSync icon",
        "default": {
          "fontPath": "resources/tweakSyncIcon.woff",
          "fontCharacter": "\\e800"
        }
      }
    }
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.0"
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "build:webview": "webpack --config webpack.config.js",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:domain": "tsc -p tsconfig.domain.json",
    "build:application": "tsc -p tsconfig.application.json",
    "build:infrastructure": "tsc -p tsconfig.infrastructure.json",
    "build:layers": "npm run build:domain && npm run build:application && npm run build:infrastructure",
    "lint:complexity": "node scripts/check-complexity.mjs",
    "check:circular": "node scripts/validate-deps.mjs",
    "test:unit": "jest --config jest.config.js --passWithNoTests",
    "test:domain": "jest --config jest.config.js --selectProjects domain --passWithNoTests",
    "test:application": "jest --config jest.config.js --selectProjects application --passWithNoTests",
    "test:infrastructure": "jest --config jest.config.js --selectProjects infrastructure --passWithNoTests"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/postcss-safe-parser": "^5.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@types/ws": "^8.18.1",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^3.1.0",
    "bufferutil": "^4.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.8.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "utf-8-validate": "^6.0.6",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@radix-ui/react-slot": "^1.3.3",
    "@shadcn/ui": "^0.0.4",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-loader": "^7.1.4",
    "lucide-react": "^1.31.0",
    "node-html-parser": "^9.0.1",
    "postcss": "^8.5.26",
    "postcss-safe-parser": "^7.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "source-map": "^0.8.0",
    "style-loader": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.21.3"
  }
}
