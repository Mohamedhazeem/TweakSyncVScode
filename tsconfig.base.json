{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "jsx": "react",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "incremental": true,
    "noEmit": true,
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@application/*": ["./src/application/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@webview/*": ["./src/webview/*"],
      "@/*": ["./src/*"]
    }
  }
}
